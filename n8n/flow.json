        }
      },
      "id": "get-scores-save",
      "name": "json-server - Leer Scores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, -80],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const incoming = $input.first().json;\nconst scores = Array.isArray(incoming.data) ? incoming.data : Array.isArray(incoming) ? incoming : $input.all().map(i => i.json).filter(s => s && s.puntaje !== undefined);\nconst saved = $('json-server - Guardar Puntaje').first().json;\nconst ordered = [...scores].sort((a,b) => Number(b.puntaje) - Number(a.puntaje));\nconst posicion = ordered.findIndex(s => String(s.id) === String(saved.id)) + 1;\nreturn [{ json: {\n  ok: true,\n  mensaje: 'Puntaje guardado correctamente',\n  registro: saved,\n  posicion: posicion || null,\n  totalJugadores: ordered.length\n}}];"
      },
      "id": "rank-save",
      "name": "Calcular Posición",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1840, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond-save",
