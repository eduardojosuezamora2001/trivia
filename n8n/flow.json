    {
      "parameters": {
        "content": "## POST /guardar-puntaje\nn8n valida y persiste usuarios + puntajes en json-server.\n\nSi n8n corre en Docker, json-server debe ser `http://host.docker.internal:3001` (no localhost).",
        "height": 240,
        "width": 380
      },
      "id": "note-save",
      "name": "Nota - Guardar",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-120, -100]
    },
    {
      "parameters": {
        "content": "## GET /leaderboard\nn8n consulta scores + users en json-server y arma el ranking.",
        "height": 220,
        "width": 360
      },
      "id": "note-board",
      "name": "Nota - Leaderboard",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-120, 650]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "guardar-puntaje",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-save",
      "name": "Webhook - Guardar Puntaje",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [300, 0],
      "webhookId": "save-score-json-server"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst nombre = String(body.nombre || '').trim();\nconst apellido = String(body.apellido || '').trim();\nconst edad = Number(body.edad);\nconst puntaje = Number(body.puntaje);\nconst tematicas = Array.isArray(body.tematicas) ? body.tematicas : [];\nconst fecha = body.fecha || new Date().toISOString();\nconst fallos = Array.isArray(body.fallos) ? body.fallos.map((f) => ({\n  tematica: String(f?.tematica || ''),\n  nombreCorrecto: String(f?.nombreCorrecto || ''),\n  imagen: String(f?.imagen || ''),\n  respuesta: String(f?.respuesta || '')\n})) : [];\n\nconst errores = [];\nif (!nombre) errores.push('nombre es requerido');\nif (!apellido) errores.push('apellido es requerido');\nif (!Number.isFinite(edad) || edad <= 0) errores.push('edad inválida');\nif (!Number.isFinite(puntaje) || puntaje < 0) errores.push('puntaje inválido');\nif (!tematicas.length) errores.push('debe incluir al menos una temática');\n\nreturn [{ json: {\n  valido: errores.length === 0,\n  errores,\n  usuario: { nombre, apellido, edad, createdAt: fecha },\n  score: { puntaje, tematicas, fecha, fallos }\n}}];"
      },
      "id": "validate-save",
      "name": "Validar y Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "valid-true",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "IF - Datos Válidos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [740, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ JSON.stringify({ ok: false, message: ($json.errores || []).join(', '), errores: $json.errores }) }}"
      },
      "id": "bad-request",
      "name": "Respond - 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/users",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.usuario) }}",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "post-user",
      "name": "json-server - Crear Usuario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, -80],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const user = $input.first().json;\nconst original = $('Validar y Normalizar').first().json;\nreturn [{ json: {\n  ...original.score,\n  userId: user.id\n}}];"
      },
      "id": "prepare-score",
      "name": "Preparar Puntaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/scores",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "post-score",
      "name": "json-server - Guardar Puntaje",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, -80],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3001/scores",
        "options": {
