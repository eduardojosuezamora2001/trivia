      },
      "id": "get-scores",
      "name": "json-server - Scores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 700],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3001/users",
        "options": {
          "response": {
            "response": {
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "get-users",
      "name": "json-server - Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 820],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "function unwrap(items) {\n  if (!items || !items.length) return [];\n  const json = items[0].json;\n  if (Array.isArray(json?.data)) return json.data;\n  if (Array.isArray(json?.scores)) return json.scores;\n  if (Array.isArray(json?.users)) return json.users;\n  if (Array.isArray(json)) return json;\n  return items.map(i => i.json).filter(row => row && typeof row === 'object' && !Array.isArray(row));\n}\n\nconst scores = unwrap($('json-server - Scores').all());\nconst users = unwrap($('json-server - Users').all());\nconst byId = new Map(users.map(u => [String(u.id), u]));\nconst webhook = $('Webhook - Leaderboard').first().json || {};\nconst query = webhook.query || {};\nconst tematica = String(query.tematica || '').toLowerCase();\nconst limit = Number(query.limit) > 0 ? Number(query.limit) : 10;\n\nlet rows = scores\n  .filter(s => s && s.puntaje !== undefined)\n  .map(s => {\n    const u = byId.get(String(s.userId)) || {};\n    return {\n      ...s,\n      nombre: u.nombre || '',\n      apellido: u.apellido || '',\n      edad: u.edad || null\n    };\n  });\n\nif (tematica) {\n  rows = rows.filter(r => Array.isArray(r.tematicas) && r.tematicas.map(x => String(x).toLowerCase()).includes(tematica));\n}\n\nrows.sort((a,b) => Number(b.puntaje) - Number(a.puntaje));\nconst leaderboard = rows.slice(0, limit).map((r,i) => ({ posicion: i + 1, ...r }));\nreturn [{ json: { ok: true, total: rows.length, leaderboard } }];"
      },
      "id": "build-board",
      "name": "Construir Leaderboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 760]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond-board",
      "name": "Respond - Leaderboard",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 760]
    }
